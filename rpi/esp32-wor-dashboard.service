[Unit]
Description=ESP32-S3 Wake-on-Radio Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=axon
SupplementaryGroups=dialout i2c
WorkingDirectory=/home/axon/wake-on-radio
ExecStart=/home/axon/wake-on-radio/.venv/bin/python3 dashboard.py --port /dev/ttyS0 --web-port 8080 --sample-rate 1000 --ina-channel 1 --ina-channels 1,2,3,4 --highspeed-channels 1,2 --shunt-ohms 0.1 --max-current 3.0 --out /dev/null
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
